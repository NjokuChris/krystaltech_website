# Copy to .env.local and fill in. Do NOT commit real keys.

# Resend email delivery for the contact form
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact enquiries are delivered
CONTACT_TO_EMAIL=krystaltech7@gmail.com

# The "from" address. MUST be on a domain you've verified in Resend,
# e.g. "Krystal Tech Hub <noreply@krystaltechhub.com>".
# Leave unset to fall back to Resend's shared sender (onboarding@resend.dev),
# which only delivers to your own Resend account email - fine for testing.
CONTACT_FROM_EMAIL=

# ---------------------------------------------------------------
# Database (Supabase Postgres) - powers the CMS (blog + announcements)
# ---------------------------------------------------------------
# From Supabase: Project Settings > Database > Connection string.
# DATABASE_URL uses the pooled connection (port 6543, pgbouncer),
# DIRECT_URL uses the direct connection (port 5432) for migrations.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------
# Auth - signs the admin session JWT (middleware + login route)
# ---------------------------------------------------------------
# Use a long random string, e.g. `openssl rand -base64 32`.
JWT_SECRET=

# ---------------------------------------------------------------
# Super admin bootstrap - used by `npm run admin:create`
# ---------------------------------------------------------------
# Creates (or updates the password of) the admin user that can log in
# at /login and reach the /admin dashboard. Rotate by changing these
# and rerunning `npm run admin:create`. Password must be >= 6 chars.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------
# Cloudinary - image uploads for projects, team photos etc.
# ---------------------------------------------------------------
# From cloudinary.com/console — Dashboard > API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
